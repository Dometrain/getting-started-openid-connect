@model OidcDemoApp.Features.UrlTools.UrlParseViewModel

@{
    ViewData["Title"] = "OAuth URL Inspector";
}

<div class="demo-page">
    <h1 class="mt-4">OAuth URL Inspector</h1>
    <p>Paste an OAuth/OIDC URL and we’ll split out the parameters into readable rows.</p>

    <form asp-action="Index" method="post">
        @Html.AntiForgeryToken()

        <div class="mb-3">
            <label asp-for="InputUrl" class="form-label"></label>
            <textarea asp-for="InputUrl" class="form-control" rows="5"
                      placeholder="Paste the full URL here..."></textarea>
            <span asp-validation-for="InputUrl" class="text-danger"></span>
        </div>

        <button type="submit" class="btn btn-primary">Parse</button>
    </form>

    @if (!string.IsNullOrWhiteSpace(Model.Error))
    {
        <div class="alert alert-danger mt-3">@Model.Error</div>
    }

    @if (!string.IsNullOrWhiteSpace(Model.BaseUrl) || (Model.Rows?.Count ?? 0) > 0)
    {
        <hr class="my-4" />

        @if (!string.IsNullOrWhiteSpace(Model.BaseUrl))
        {
            <div class="mb-2">
                <strong>Base URL:</strong>
                <code>@Model.BaseUrl</code>
            </div>
        }

        @if (!string.IsNullOrWhiteSpace(Model.FragmentPath))
        {
            <div class="mb-3">
                <strong>Fragment:</strong>
                <code>#@Model.FragmentPath</code>
                <div class="text-muted small">Note: many providers put parameters in the fragment (#?...) for SPA flows.</div>
            </div>
        }

        @if (Model.Rows != null && (Model.Rows?.Count ?? 0) > 0)
        {
            <h4>Parameters</h4>

            <table class="table table-striped table-bordered align-middle mt-2">
                <thead>
                    <tr>
                        <th style="width: 22%;">Key</th>
                        <th>Value</th>
                        @*                         <th style="width: 14%;">Source</th> *@
                    </tr>
                </thead>
                <tbody>
                    @if (Model != null && Model.Rows != null)
                    {
                        foreach (var row in Model.Rows)
                        {
                            <tr>
                                <td><code>@row.Key</code></td>
                                <td style="word-break: break-all;">
                                    <code>@row.Value</code>
                                </td>
                                @*                             <td>
                                @(row.FromFragment ? "Fragment (#)" : "Query (?)")
                            </td> *@
                            </tr>
                        }
                    }
                </tbody>
            </table>

            @*             <details class="mt-3">
                <summary>Copy as key=value lines</summary>
                <pre style="white-space: pre-wrap; word-break: break-word;">@string.Join("\n", Model.Rows.Select(r => $"{r.Key}={r.Value}"))</pre>
            </details> *@
        }
        else
        {
            <div class="alert alert-warning mt-3">No query parameters found in the URL.</div>
        }
    }
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
