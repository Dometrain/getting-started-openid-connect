@{
    ViewData["Title"] = "Tokens Received";
}

<div class="demo-page">
    <h1>Authenticated using the implicit flow (form post)</h1>
    <p class="text-muted">These values were posted back by the authorization server.</p>

    <h2 class="h4 mt-4">Token details</h2>
    <table class="table table-bordered param-table">
        <tr>
            <th>scope</th>
            <td id="scope">@ViewData["scope"]</td>
        </tr>
        <tr>
            <th>expires_in</th>
            <td id="expires_in">@ViewData["expires_in"]</td>
        </tr>
        <tr>
            <th>token_type</th>
            <td id="token_type">@ViewData["token_type"]</td>
        </tr>
        <tr>
            <th>state</th>
            <td id="state">@ViewData["state"]</td>
        </tr>
        <tr>
            <th>id_token<br /><span id="jwt_io_idtokenurl"></span></th>
            <td id="id_token" class="token-value">@ViewData["id_token"]</td>
        </tr>
        <tr>
            <th>access_token<br /><span id="jwt_io_accessurl"></span></th>
            <td id="access_token" class="token-value">@ViewData["access_token"]</td>
        </tr>
    </table>
</div>

@section scripts {
    <script>
        $(document).ready(function () {
            $("#jwt_io_idtokenurl").html('<a href="https://jwt.io/#value=' + encodeURIComponent('@ViewData["id_token"]') + '" target="_blank">jwt.io</a>');
            $("#jwt_io_accessurl").html('<a href="https://jwt.io/#value=' + encodeURIComponent('@ViewData["access_token"]') + '" target="_blank">jwt.io</a>');
        });
    </script>
}
