@model OidcDemoApp.Features.CombinedFlows.CombinedFlowsViewModel
@{
    ViewData["Title"] = "Combining the Flows";
    var hasClientToken = !string.IsNullOrWhiteSpace(Model.ClientAccessToken);
}

<div class="demo-page">
    <h1>Combining the flows</h1>
    <p class="text-muted">
        One client, two access tokens. It uses its own token for background work, and the
        signed-in user's token for work done on that user's behalf.
    </p>

    <form asp-controller="CombinedFlows" asp-action="Index" method="post">
        @Html.AntiForgeryToken()

        <div class="row g-4">
            <div class="col-md-6">
                <h2 class="h5">Client credentials</h2>
                <div class="param-hint mb-3">
                    The client's own token, asked for directly. No user involved, so it is
                    available whether or not anyone is signed in.
                </div>

                <div class="mb-2">
                    <label asp-for="GrantType" class="form-label mb-0">grant_type</label>
                    <input asp-for="GrantType" class="form-control form-control-sm" />
                </div>

                <div class="mb-2">
                    <label asp-for="ClientId" class="form-label mb-0">client_id</label>
                    <input asp-for="ClientId" class="form-control form-control-sm" />
                </div>

                <div class="mb-2">
                    <label asp-for="ClientSecret" class="form-label mb-0">client_secret</label>
                    <input asp-for="ClientSecret" class="form-control form-control-sm" />
                </div>

                <div class="mb-3">
                    <label asp-for="Scope" class="form-label mb-0">scope</label>
                    <input asp-for="Scope" class="form-control form-control-sm" />
                </div>

                <button type="submit" class="btn btn-primary">Get Client Token</button>

                @if (!string.IsNullOrWhiteSpace(Model.ClientTokenError))
                {
                    <div class="alert alert-danger mt-3">@Model.ClientTokenError</div>
                }

                @if (hasClientToken)
                {
                    <div class="mt-3">
                        <label asp-for="ClientAccessToken" class="form-label mb-0">access_token</label>
                        <div class="param-hint">scope: <code>@Model.ClientScopes</code>. No <code>sub</code>, because there is no user</div>
                        <textarea asp-for="ClientAccessToken" class="form-control token-value" rows="8"></textarea>
                    </div>
                }
            </div>

            @if (hasClientToken)
            {
                <div class="col-md-6">
                    <h2 class="h5">Authorization code</h2>
                    <div class="param-hint mb-3">
                        The signed-in user's token. There is no button here: it arrived with the login.
                    </div>

                    @if (!Model.IsUserSignedIn)
                    {
                        <div class="alert alert-secondary">
                            <strong>No user signed in.</strong>
                            The client can still do its own work. It just has nobody to act for.
                        </div>
                    }
                    else
                    {
                        <table class="table table-sm">
                            <tbody>
                                <tr>
                                    <th class="col-4">Signed in as</th>
                                    <td>@Model.UserDisplayName <span class="text-muted">(sub @Model.UserSubject)</span></td>
                                </tr>
                                <tr>
                                    <th>Roles</th>
                                    <td>
                                        @if (string.IsNullOrWhiteSpace(Model.UserRoles))
                                        {
                                            <span class="text-danger">none</span>
                                            <span class="text-muted">(cannot reach /payments, which needs the finance role)</span>
                                        }
                                        else
                                        {
                                            <code>@Model.UserRoles</code>
                                        }
                                    </td>
                                </tr>
                            </tbody>
                        </table>

                        <div class="mt-3">
                            <label class="form-label mb-0">access_token</label>
                            <div class="param-hint">scope: <code>@Model.UserScopes</code></div>
                            <textarea class="form-control token-value" rows="8" readonly>@Model.UserAccessToken</textarea>
                        </div>
                    }
                </div>
            }
        </div>

        @if (hasClientToken)
        {
            <hr class="my-4" />

            <p class="text-muted">
                @if (Model.IsUserSignedIn)
                {
                    <text>
                        Two calls: <code>/identity</code> with the client's own token, and
                        <code>/payments</code> with the user's token.
                    </text>
                }
                else
                {
                    <text>
                        One call: <code>/identity</code> with the client's own token. The user call is
                        skipped because there is no user.
                    </text>
                }
            </p>

            <button type="submit" name="callapis" value="Call APIs" class="btn btn-success">Call APIs</button>
        }
    </form>

    @if (Model.WasCalled)
    {
        <h2 class="h4 mt-4">Results</h2>

        <div class="row g-4">
            @foreach (var call in new[] { Model.ServiceCall, Model.UserCall })
            {
                <div class="col-md-6">
                    @if (call == null)
                    {
                        <div class="alert alert-secondary">
                            No user signed in, so no call was made on anyone's behalf.
                        </div>
                    }
                    else
                    {
                        <div class="param-hint"><code>GET @call.Url</code></div>
                        <div class="param-hint">@call.TokenDescription</div>

                        @if (call.Error != null)
                        {
                            <div class="alert alert-danger mt-2">@call.Error</div>
                        }
                        else
                        {
                            <div class="alert @(call.IsSuccess ? "alert-success" : "alert-warning") mt-2 mb-2 py-2">
                                HTTP @call.StatusCode
                            </div>
                            <pre class="flow-pane border rounded p-2 mb-0">@call.Body</pre>
                        }
                    }
                </div>
            }
        </div>
    }
</div>
