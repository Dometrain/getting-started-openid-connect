@using OidcDemoApp.Features.Tools
@model CustomKeyTokenViewModel

@{
    ViewData["Title"] = "Sign a Token With Your Own Key";
}

<div class="demo-page">
    <h1 class="mt-4">Sign a token with your own key</h1>
    <p>
        Bring your own private key, generated with OpenSSL, and sign a JWT with it. Pick a
        signature family and the same payload is signed three times, once with each hash
        size, so the three can be compared. Verify any of them at
        <a href="https://jwt.io" target="_blank" rel="noopener">jwt.io</a> with the matching
        public key.
    </p>

    <form method="post" class="token-builder-form">
        @Html.AntiForgeryToken()

        <div class="row g-3">
            <div class="col-md-6">
                <label asp-for="Header" class="form-label fw-semibold"></label>
                <textarea asp-for="Header" class="form-control token-value jwt-source" rows="5"></textarea>
                <div class="param-hint mt-1">
                    <code>alg</code> is rewritten when you sign, so each of the three tokens names
                    the algorithm that actually produced it.
                </div>
                @if (Model.HeaderWarning != null)
                {
                    <div class="text-danger small mt-1">@Model.HeaderWarning</div>
                }
            </div>
            <div class="col-md-6">
                <label asp-for="Payload" class="form-label fw-semibold"></label>
                <textarea asp-for="Payload" class="form-control token-value jwt-source" rows="12"></textarea>
                <div class="param-hint mt-1">
                    The same claims the other two generators use, so the tokens stay comparable.
                </div>
                @if (Model.PayloadWarning != null)
                {
                    <div class="text-danger small mt-1">@Model.PayloadWarning</div>
                }
            </div>
        </div>

        <div class="mt-3 mb-2">
            <button type="submit" asp-action="EncodeCustomKeyToken" class="btn btn-primary">
                Step 1: Base64url encode
            </button>
            <button type="submit" asp-action="ResetCustomKeyToken" class="btn btn-outline-secondary ms-1">
                Reset to defaults
            </button>
        </div>

        @if (Model.Stage >= TokenBuildStage.Encoded)
        {
            <div class="jwt-stale-notice text-danger small" data-stale-for="encoded-steps">
                The header or payload has changed. Press <span class="fw-semibold">Step 1: Base64url encode</span>
                to encode the new version.
            </div>

            <div class="jwt-step-group" id="encoded-steps">
                <div class="jwt-flow-arrow">&darr;&nbsp;&nbsp;Base64url encode each part&nbsp;&nbsp;&darr;</div>

                <div class="row g-3">
                    <div class="col-md-6">
                        <pre class="jwt-box token-value jwt-header">@Model.EncodedHeader</pre>
                    </div>
                    <div class="col-md-6">
                        <pre class="jwt-box token-value jwt-payload">@Model.EncodedPayload</pre>
                    </div>
                </div>

                <div class="jwt-flow-arrow">&darr;&nbsp;&nbsp;Join them with a dot&nbsp;&nbsp;&darr;</div>

                <label class="form-label fw-semibold">Signing input</label>
                <pre class="jwt-box token-value mb-1"><span class="jwt-header">@Model.EncodedHeader</span>.<span class="jwt-payload">@Model.EncodedPayload</span></pre>
                <div class="param-hint">
                    The payload segment is fixed from here on. The header segment is not: each of
                    the three tokens below carries its own <code>alg</code>, so each one signs a
                    slightly different string.
                </div>
            </div>

            <div class="mt-4 mb-2">
                <label asp-for="PrivateKey" class="form-label fw-semibold"></label>
                <textarea asp-for="PrivateKey" class="form-control token-value pem-box jwt-secret" rows="10"
                          placeholder="-----BEGIN PRIVATE KEY-----"></textarea>
                <div class="param-hint mt-1">
                    Paste the whole PEM block, BEGIN and END lines included. Use a throwaway demo
                    key: never paste a real private key into a web page, including this one.
                    @if (Model.KeyDescription != null)
                    {
                        <span class="fw-semibold d-block mt-1">Key read: @Model.KeyDescription</span>
                    }
                </div>
                @if (Model.KeyError != null)
                {
                    <div class="text-danger small mt-1">@Model.KeyError</div>
                }
            </div>

            <label class="form-label fw-semibold">Signature family</label>
            <div class="row g-3 mb-3">
                @foreach (var choice in CustomKeyTokenViewModel.FamilyChoices)
                {
                    <div class="col-md-4">
                        <div class="form-check jwt-box h-100">
                            <input class="form-check-input jwt-secret" type="radio" asp-for="Family"
                                   value="@choice.Family" id="family-@choice.Family" />
                            <label class="form-check-label" for="family-@choice.Family">
                                <span class="fw-semibold">@choice.Family.ToString()xxx</span>
                                <span class="d-block small">@choice.Scheme</span>
                                <span class="param-hint d-block mt-1">@choice.Summary</span>
                            </label>
                        </div>
                    </div>
                }
            </div>

            <div class="mb-3">
                <button type="submit" asp-action="SignCustomKeyToken" class="btn btn-primary">
                    Step 2: Sign with the private key
                </button>
            </div>
        }

        @if (Model.Stage == TokenBuildStage.Complete)
        {
            <div class="jwt-stale-notice text-danger small" data-stale-for="signed-steps">
                Something above has changed. Press <span class="fw-semibold">Step 2: Sign with the private key</span>
                to sign again.
            </div>

            <div class="jwt-step-group" id="signed-steps">
                <div class="jwt-flow-arrow">&darr;&nbsp;&nbsp;Sign the same payload with each hash size&nbsp;&nbsp;&darr;</div>

                @foreach (var variant in Model.Variants)
                {
                    <div class="jwt-box mb-3">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-semibold">@variant.Algorithm</span>
                            @if (variant.SignatureBytes != null)
                            {
                                <span class="param-hint mb-0">@variant.SignatureBytes byte signature</span>
                            }
                        </div>

                        @if (variant.Unavailable != null)
                        {
                            <div class="text-danger small">@variant.Unavailable</div>
                        }
                        else
                        {
                            <pre class="token-value mb-2"><span class="jwt-header">@variant.EncodedHeader</span>.<span class="jwt-payload">@Model.EncodedPayload</span>.<span class="jwt-signature">@variant.Signature</span></pre>
                            <button type="button" class="btn btn-sm btn-outline-secondary copy-button" data-value="@variant.Token">Copy token</button>
                        }
                    </div>
                }

                <div class="param-hint">
                    Signed with @Model.KeyDescription. Compare the three signature lengths: for an
                    RSA key they are all the same, because an RSA signature is the size of the key
                    rather than the size of the hash. Change to a larger key and all three grow
                    together.
                </div>

                <div class="param-hint mt-2">
                    To verify one, open <a href="https://jwt.io" target="_blank" rel="noopener">jwt.io</a>,
                    paste the token, and give it the public key that belongs to this private key.
                    Export it with <code>openssl pkey -pubout</code>.
                </div>
            </div>
        }
    </form>
</div>

@section Scripts {
    <script src="~/js/token-builder.js" asp-append-version="true"></script>
}
